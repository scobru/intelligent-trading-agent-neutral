# ==============================================================================
# OpenRouter AI
# ==============================================================================
# Chiave da https://openrouter.ai/keys (inizia con sk-or-v1-)
OPENROUTER_API_KEY=""
# Modello usato per le decisioni (default: openrouter/free).
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_MAX_ATTEMPTS="3"

# ==============================================================================
# Wallet su Base
# ==============================================================================
# Lo stesso wallet tiene lo spot (Uniswap) e firma su SynFutures (Gate + short)
WALLET_ADDRESS="0x..."
# Chiave privata del wallet: NON committarla mai.
# Usa un wallet dedicato al bot, con dentro solo il capitale che puoi perdere.
PRIVATE_KEY=""
# RPC di Base (Alchemy, QuickNode, Infura o il pubblico https://mainnet.base.org)
BASE_RPC_URL="https://mainnet.base.org"
# Microservizio SynFutures avviato da start.sh (non cambiarlo in Docker)
SYNFUTURES_SERVICE_URL="http://localhost:3100"

# ==============================================================================
# Modalita'
# ==============================================================================
# true = il ciclo gira ma NON firma nessuna transazione. Parti sempre da qui.
DRY_RUN="true"
# Paper: portafoglio virtuale con funding e prezzi reali. Implica DRY_RUN e
# non richiede WALLET_ADDRESS ne' PRIVATE_KEY.
PAPER_TRADING="false"
PAPER_START_USDC="1000"
PAPER_GAS_USD="0.02"

# ==============================================================================
# Coppie e dimensionamento
# ==============================================================================
# Asset coperti: ETH (WETH + ETH-USDC-LINK) e BTC (cbBTC + BTC-USDC-LINK)
NEUTRAL_ASSETS="ETH,BTC"
# Leva dello short: 2 = capitale per 2/3 in spot e 1/3 in margine
PERP_LEVERAGE="2"
MAX_ASSET_PCT="0.60"
MIN_POSITION_USD="150"
MAX_POSITION_USD="5000"

# ==============================================================================
# Funding
# ==============================================================================
# Media su cui si decide e numero minimo di osservazioni (una per ciclo)
FUNDING_LOOKBACK_HOURS="24"
FUNDING_MIN_OBSERVATIONS="3"
# APR medio minimo per aprire, gia' diluito dal nostro short
MIN_ENTRY_APR="10"
# Uscita automatica: media sotto EXIT_APR (dopo MIN_HOLD_HOURS) o
# funding istantaneo sotto PANIC_EXIT_APR
EXIT_APR="0"
PANIC_EXIT_APR="-30"
MIN_HOLD_HOURS="12"
# I costi di apertura + chiusura devono ripagarsi entro tot giorni
MAX_BREAKEVEN_DAYS="7"

# ==============================================================================
# Rischio
# ==============================================================================
AUTO_RISK_EXITS="true"
# Se il prezzo sale lo short perde margine: oltre questa leva effettiva si chiude
MAX_EFFECTIVE_LEVERAGE="5"
# Differenza massima fra spot e short prima di considerare rotto l'hedge
MAX_HEDGE_DRIFT_PCT="10"

# ==============================================================================
# Costi stimati e sicurezza operativa
# ==============================================================================
EST_SWAP_COST_BPS="10"
EST_PERP_FEE_BPS="5"
EST_TX_COST_USD="0.05"
MIN_ETH_RESERVE="0.001"
MAX_SLIPPAGE_BPS="100"
DEFAULT_SLIPPAGE_BPS="50"
MAX_GAS_PRICE_GWEI="0.5"

# ==============================================================================
# Telegram (opzionale)
# ==============================================================================
TELEGRAM_BOT_TOKEN=""
# I comandi sono accettati solo da questa chat
TELEGRAM_CHAT_ID=""

# ==============================================================================
# Runtime
# ==============================================================================
PORT="3000"
# Intervallo fra i cicli (default 30 minuti)
TRADING_INTERVAL="1800"
# Abilita il pulsante "Esegui ciclo ora" della dashboard (vuoto = disattivato)
DASHBOARD_RUN_TOKEN=""
# Avviso "ricarica il wallet" in dashboard e su Telegram quando l'ETH per il
# gas scende sotto questa soglia (default 0.002); sotto MIN_ETH_RESERVE
# la dashboard segna "ricarica ora"
# GAS_WARN_ETH=""
# Percorsi dello stato. Lasciali vuoti: il bot usa /app/data da solo quando
# quella cartella esiste (volume persistente CapRover/Docker).
# SQLITE_DB_PATH="/app/data/neutral_agent.db"
# POSITIONS_PATH="/app/data/positions.json"
